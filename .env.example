TELEGRAM_BOT_TOKEN=
# Telegram user ID; only this user's private chat is accepted.
TELEGRAM_OWNER_ID=
# Random secret; also pass this value as secret_token when setting the webhook.
TELEGRAM_WEBHOOK_SECRET=
GROQ_API_KEY=
# Override if your Groq account uses another supported model.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Service account JSON on a single line; share the spreadsheet with its email.
GOOGLE_CLOUD_CREDENTIALS=
SHEET_ID=
# Use an absolute path on a persistent disk in production.
STATE_DB_PATH=./data/state.sqlite3
